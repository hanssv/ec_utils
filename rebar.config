{erl_opts, [debug_info, warn_missing_spec_all, warnings_as_errors]}.

{plugins, [
    {eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar.git", {branch, "master"}}}
]}.

{deps,
  [{sha3, {git, "https://github.com/aeternity/erlang-sha3", {ref, "b5f27a2"}}}]}.

{profiles, [{test, [{erl_opts, [nowarn_missing_spec_all, nowarn_missing_spec]},
                        {deps, [{enacl, {git, "https://github.com/aeternity/enacl.git", {ref, "c47b1b2"}}},
                                {ecrecover, {git, "https://github.com/aeternity/ecrecover.git", {ref, "74b7816"}}}]}]},
            {eqc, [{erl_opts, [nowarn_missing_spec_all, nowarn_missing_spec]},
                   {deps, [{enacl, {git, "https://github.com/aeternity/enacl.git", {ref, "c47b1b2"}}},
                           {ecrecover, {git, "https://github.com/aeternity/ecrecover.git", {ref, "74b7816"}}}]}]}
           ]}.
