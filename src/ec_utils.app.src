{application, ec_utils, [
  {description, "A collection of elliptic curve utility functions"},
  {vsn, "0.1.0"},
  {registered, []},
  {applications, [kernel, stdlib, crypto]},
  {env, []},
  {modules, [
    ecu_secp256k1,
    ecu_ed25519,
    ecu_ed448,
    ecu_ecdsa,
    ecu_eddsa,
    ecu_eddsa448,
    ecu_crypto,
    ecu_misc,
    ecu_schnorr,
    ecu_frost,
    ecu_frost_dkg,
    ecu_ecdh,
    ecu_keccak,
    ecu_musig2,
    ecu_base58,
    ecu_hd,
    ecu_bip39_words,
    ecu_bip39,
    ecu_bech32,
    ecu_h2c,
    ecu_ml_kem,
    ecu_ml_dsa,
    ecu_slh_dsa,
    ecu_fn_dsa,
    ecu_fn_dsa_fft,
    ecu_bls12_381,
    ecu_bls12_381_fp,
    ecu_bls12_381_pairing,
    ecu_bls12_381_h2c,
    ecu_bls12_381_sig,
    ecu_groth16,
    ecu_compat,
    ecu_entropy,
    ecu_sha2,
    ecu_ripemd160,
    ecu_hmac,
    ecu_hkdf,
    ecu_pbkdf2
  ]},
  {licenses, ["MIT"]},
  {links, []}
]}.
